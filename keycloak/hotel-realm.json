{
  "realm": "hotel",
  "displayName": "Royal Tulip Korbous Bay",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full access"
      },
      {
        "name": "MANAGER",
        "description": "Hotel management"
      },
      {
        "name": "STAFF",
        "description": "Hotel staff"
      },
      {
        "name": "CLIENT",
        "description": "Hotel guest"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-hotel",
        "description": "Roles given to every new user",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "CLIENT"
          ]
        }
      }
    ]
  },
