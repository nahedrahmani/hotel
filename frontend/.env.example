# Copy this file to .env and fill in values for your environment

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:9999
VITE_KEYCLOAK_REALM=hotel
VITE_KEYCLOAK_CLIENT_ID=user-service

# API Gateway base URL (used for user sync and all authenticated requests)
VITE_API_BASE_URL=http://localhost:8180

# Maison/guest-house service URL
VITE_MAISON_SERVICE_URL=http://localhost:8895

# CORS allowed origins (used in api-gateway and services)
# CORS_ALLOWED_ORIGINS=https://your-production-domain.com
