# ── Email notifications (reservation-service) ─────────────────────────────────
# Without these lines, booking e-mails go to Mailpit (http://localhost:8026).
# To send real e-mails, uncomment and fill in an SMTP account:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=noreply@your-hotel.example
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@your-hotel.example
# MAIL_ENABLED=false   # to send no e-mail at all

# ── Online payment with Konnect (payment-service) ─────────────────────────────
# Tunisian gateway, in dinars (card, wallet, e-DINAR). Test keys: create an account on
# https://dashboard.sandbox.konnect.network, then an organisation; copy its wallet ID and
# generate an API key. Without them, guests see "à régler à la réception".
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Production: KONNECT_BASE_URL=https://api.konnect.network/api/v2
# For demos without Konnect (no real payment, clearly marked in the app):
# KONNECT_MODE=simulation
# Optional, needs a public address Konnect can reach:
# KONNECT_WEBHOOK_URL=https://your-domain/api/payment/konnect/webhook

# ── Cloudinary file storage (client-service) ──────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=ddbunaglw
CLOUDINARY_API_KEY=915436136837845
CLOUDINARY_API_SECRET=REPLACE_ME

# ── MongoDB (user-service) ────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=tourism
MONGO_INITDB_ROOT_PASSWORD=tourism

# ── RabbitMQ (reservation-service event bus) ──────────────────────────────────
# Defaults work for the bundled Docker container.
RABBITMQ_DEFAULT_USER=hotel
RABBITMQ_DEFAULT_PASS=hotel

# ── Service account (reservation-service → chambre/payment) ───────────────────
# Must match the "reservation-service" client secret in Keycloak (keycloak/hotel-realm.json)
RESERVATION_SERVICE_SECRET=change-me

# ── Account updates (user-service → Keycloak admin API) ───────────────────────
# Must match the "user-service-admin" client secret in Keycloak (keycloak/hotel-realm.json)
USER_SERVICE_ADMIN_SECRET=change-me
